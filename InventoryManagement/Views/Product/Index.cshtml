@model IEnumerable<Product>

@{
    ViewData["Title"] = "Products";
    var items = Model.ToList();
    var stockValue = items.Sum(p => p.Price * p.Quantity);
}

<div class="page-head mb-4">
    <div>
        <p class="eyebrow">INVENTORY MANAGEMENT</p>
        <h1>Product Inventory</h1>
        <p class="mb-0">Add, search, update and remove stock using ADO.NET CRUD operations.</p>
    </div>
    <div class="stats">
        <div class="stat"><strong>@items.Count</strong><span>Products</span></div>
        <div class="stat"><strong>₹@stockValue.ToString("N0")</strong><span>Stock value</span></div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-3 p-md-4">
        <form asp-action="Index" method="get" class="row g-2 mb-3">
            <div class="col-md-8">
                <input name="search" value="@ViewBag.Search" class="form-control" placeholder="Search by product, category or supplier..." />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-dark px-4">Search</button>
            </div>
            <div class="col-auto">
                <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Product</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Stock</th>
                        <th>Supplier</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in items)
                    {
                        <tr>
                            <td class="text-muted">#@item.ProductId</td>
                            <td class="fw-semibold">@item.ProductName</td>
                            <td><span class="badge rounded-pill bg-light text-dark border">@item.Category</span></td>
                            <td>₹@item.Price.ToString("N2")</td>
                            <td><span class="stock @(item.Quantity == 0 ? "danger" : item.Quantity < 10 ? "warning" : "good")">@item.Quantity</span></td>
                            <td>@item.Supplier</td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@item.ProductId" class="btn btn-sm btn-outline-primary">Edit</a>
                                <a asp-action="Delete" asp-route-id="@item.ProductId" class="btn btn-sm btn-outline-danger">Delete</a>
                            </td>
                        </tr>
                    }
                    @if (items.Count == 0)
                    {
                        <tr><td colspan="7" class="text-center py-5 text-muted">No products found.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
