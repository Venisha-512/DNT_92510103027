@model Feedback

@{
    ViewData["Title"] = "Give Feedback";
}

<h2>Give Feedback</h2>

@using (Html.BeginForm("Create", "Feedback", FormMethod.Post))
{
    @Html.ValidationSummary(true, "", new { @class = "field-validation-error" })

    <div class="form-group">
        @Html.LabelFor(m => m.Name)
        @Html.TextBoxFor(m => m.Name, new { placeholder = "Enter your full name" })
        @Html.ValidationMessageFor(m => m.Name)
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.Email)
        @Html.TextBoxFor(m => m.Email, new { placeholder = "name@example.com" })
        @Html.ValidationMessageFor(m => m.Email)
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.Phone)
        @Html.TextBoxFor(m => m.Phone, new { placeholder = "10-digit mobile number" })
        @Html.ValidationMessageFor(m => m.Phone)
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.Subject)
        @Html.DropDownListFor(m => m.Subject,
            new List<SelectListItem>
            {
                new SelectListItem { Text = "Course Content", Value = "Course Content" },
                new SelectListItem { Text = "Faculty", Value = "Faculty" },
                new SelectListItem { Text = "Laboratory", Value = "Laboratory" },
                new SelectListItem { Text = "Other", Value = "Other" }
            },
            "-- Select Subject --")
        @Html.ValidationMessageFor(m => m.Subject)
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.Rating)
        <div class="rating">
            @for (int i = 1; i <= 5; i++)
            {
                <label class="rating-option">
                    @Html.RadioButtonFor(m => m.Rating, i, new { id = "Rating" + i })
                    @i
                </label>
            }
        </div>
        @Html.ValidationMessageFor(m => m.Rating)
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.Comments)
        @Html.TextAreaFor(m => m.Comments, 5, 60, new { placeholder = "Write your feedback here" })
        @Html.ValidationMessageFor(m => m.Comments)
    </div>

    <div class="form-group">
        <label class="check">
            @Html.CheckBoxFor(m => m.WantsCopy)
            @Html.DisplayNameFor(m => m.WantsCopy)
        </label>
    </div>

    <input type="submit" value="Submit Feedback" class="btn" />
}

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
