<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StockDesk</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <div class="container d-flex justify-content-between align-items-center">
            <a class="brand" asp-controller="Product" asp-action="Index">Stock<span>Desk</span></a>
            <a class="btn btn-light btn-sm fw-semibold" asp-controller="Product" asp-action="Create">+ Add Product</a>
        </div>
    </header>

    <main class="container py-4">
        @if (TempData["Success"] is string message)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                @message
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="foot">Inventory Management Module &bull; ASP.NET Core MVC &bull; ADO.NET</footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
